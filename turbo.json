{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalEnv": [
        "APP_PORT",
        "DB_HOST",
        "DB_NAME",
        "DB_PASSWORD",
        "DB_PORT",
        "DB_USERNAME",
        "KAFKA_BOOTSTRAP_SERVER",
        "KAFKA_BROKERS",
        "TCP_PORT"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "test:typecheck": {
            "dependsOn": ["^test:typecheck"]
        },
        "test:unit:run": {
            "dependsOn": ["^test:typecheck"]
        },
        "test:unit:watch": {
            "dependsOn": ["test:typecheck"]
        },
        "test:e2e:run": {
            "dependsOn": ["^test:typecheck"]
        },
        "test:e2e:watch": {
            "dependsOn": ["test:typecheck"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
