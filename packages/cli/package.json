{
    "name": "@dugongjs/cli",
    "version": "0.0.48",
    "author": "Erik Lysne",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "dugong",
        "dugongjs"
    ],
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist",
        "linkDirectory": false
    },
    "bin": {
        "dugong": "./index.js"
    },
    "scripts": {
        "test:typecheck": "tsc --noEmit",
        "test:unit:run": "vitest --config vitest.config.unit.ts run",
        "test:unit:watch": "vitest --config vitest.config.unit.ts watch",
        "dugong": "vite-node ./src/index.ts",
        "lint": "eslint .",
        "build": "vite-node ./scripts/build.ts",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@dugongjs/core": "workspace:*",
        "@dugongjs/nestjs": "workspace:*",
        "@dugongjs/nestjs-microservice-query": "workspace:*",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/microservices": "^12.0.1",
        "@tanstack/react-query": "^5.89.0",
        "chalk": "^5.4.1",
        "commander": "^13.1.0",
        "figures": "^6.1.0",
        "fullscreen-ink": "^0.1.0",
        "ink": "^6.3.0",
        "ink-select-input": "^6.2.0",
        "ink-text-input": "^6.0.0",
        "jsondiffpatch": "^0.7.3",
        "react": "^19.1.1",
        "reflect-metadata": "catalog:",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@dugongjs/eslint-config": "workspace:*",
        "@dugongjs/scripts": "workspace:*",
        "@dugongjs/typescript-config": "workspace:*",
        "@nestjs/testing": "^12.0.1",
        "@swc/core": "^1.11.21",
        "@swc/helpers": "^0.5.17",
        "@types/node": "^26.6.5",
        "@types/react": "^19.1.13",
        "eslint": "catalog:",
        "typescript": "catalog:",
        "unplugin-swc": "catalog:",
        "vite-node": "^3.1.2",
        "vitest": "catalog:"
    }
}
