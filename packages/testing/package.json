{
    "name": "@dugongjs/testing",
    "version": "0.0.26",
    "author": "Erik Lysne",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "dugong",
        "dugongjs"
    ],
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist",
        "linkDirectory": false
    },
    "scripts": {
        "lint": "eslint .",
        "test:unit:run": "vitest --config vitest.config.unit.ts run",
        "test:unit:watch": "vitest --config vitest.config.unit.ts watch",
        "build": "vite-node ./scripts/build.ts",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "@dugongjs/core": "workspace:*"
    },
    "dependencies": {
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@dugongjs/core": "workspace:*",
        "@dugongjs/eslint-config": "workspace:*",
        "@dugongjs/scripts": "workspace:*",
        "@dugongjs/typescript-config": "workspace:*",
        "@types/node": "^24.5.1",
        "eslint": "catalog:",
        "reflect-metadata": "^0.2.2",
        "typescript": "catalog:",
        "vite-node": "^3.1.2",
        "vitest": "catalog:"
    }
}
