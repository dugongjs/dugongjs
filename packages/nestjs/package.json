{
    "name": "@dugongjs/nestjs",
    "version": "0.0.40",
    "author": "Erik Lysne",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "dugong",
        "dugongjs"
    ],
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist",
        "linkDirectory": false
    },
    "scripts": {
        "test:typecheck": "tsc --noEmit",
        "test:unit:run": "vitest --config vitest.config.unit.ts run",
        "test:unit:watch": "vitest --config vitest.config.unit.ts watch",
        "lint": "eslint .",
        "build": "vite-node ./scripts/build.ts",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "@dugongjs/core": "workspace:*",
        "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.1",
        "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.1"
    },
    "devDependencies": {
        "@dugongjs/core": "workspace:*",
        "@dugongjs/eslint-config": "workspace:*",
        "@dugongjs/scripts": "workspace:*",
        "@dugongjs/typescript-config": "workspace:*",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/testing": "^12.0.1",
        "@swc/core": "^1.11.21",
        "@swc/helpers": "^0.5.17",
        "@types/node": "^24.5.1",
        "eslint": "catalog:",
        "reflect-metadata": "catalog:",
        "typescript": "catalog:",
        "unplugin-swc": "catalog:",
        "vite-node": "^3.1.2",
        "vitest": "catalog:",
        "vitest-mock-extended": "^2.0.2",
        "zod": "^3.24.3"
    }
}
