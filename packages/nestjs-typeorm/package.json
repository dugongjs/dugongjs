{
    "name": "@dugongjs/nestjs-typeorm",
    "version": "0.0.40",
    "author": "Erik Lysne",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "dugong",
        "dugongjs"
    ],
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./driver/postgres": "./src/driver/postgres/index.ts",
        "./driver/sqlite": "./src/driver/sqlite/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist",
        "linkDirectory": false
    },
    "scripts": {
        "test:typecheck": "tsc --noEmit",
        "test:unit:run": "vitest --config vitest.config.unit.ts run",
        "test:unit:watch": "vitest --config vitest.config.unit.ts watch",
        "test:e2e:run": "DEBUG=testcontainers* vitest run --config vitest.config.e2e.ts && vitest run --config vitest.config.e2e.sqlite.ts",
        "test:e2e:watch": "DEBUG=testcontainers* vitest watch --ui --config vitest.config.e2e.ts",
        "test:e2e:watch:sqlite": "vitest watch --ui --config vitest.config.e2e.sqlite.ts",
        "lint": "eslint .",
        "build": "vite-node ./scripts/build.ts",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "@dugongjs/core": "workspace:*",
        "@dugongjs/nestjs": "workspace:*",
        "@dugongjs/typeorm": "workspace:*",
        "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.1",
        "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.1",
        "@nestjs/typeorm": "^10.0.0 || ^11.0.0 || ^12.0.1",
        "typeorm": "^0.3.22"
    },
    "devDependencies": {
        "@dugongjs/core": "workspace:*",
        "@dugongjs/eslint-config": "workspace:*",
        "@dugongjs/nestjs": "workspace:*",
        "@dugongjs/scripts": "workspace:*",
        "@dugongjs/testing-contracts": "workspace:*",
        "@dugongjs/typeorm": "workspace:*",
        "@dugongjs/typescript-config": "workspace:*",
        "@faker-js/faker": "^10.5.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/testing": "^12.0.1",
        "@nestjs/typeorm": "^12.0.0",
        "@swc/core": "^1.11.21",
        "@swc/helpers": "^0.5.17",
        "@testcontainers/postgresql": "catalog:",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.5.1",
        "@types/pg": "^8.11.14",
        "@vitest/ui": "catalog:",
        "better-sqlite3": "^13.0.3",
        "dotenv": "^16.5.0",
        "eslint": "catalog:",
        "pg": "^8.15.6",
        "reflect-metadata": "catalog:",
        "typeorm": "^0.3.22",
        "typescript": "catalog:",
        "unplugin-swc": "catalog:",
        "vite-node": "^3.1.2",
        "vitest": "catalog:",
        "vitest-mock-extended": "^2.0.2"
    }
}
